{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dostyq-pdf-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "dostyq-pdf-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4173"
      ],
      "port": 4173
    },
    {
      "name": "dostyq-pdf-lan-https",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--host",
        "0.0.0.0",
        "--port",
        "4444"
      ],
      "port": 4444,
      "url": "https://localhost:4444"
    },
    {
      "name": "dostyq-pdf-lan",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--host",
        "0.0.0.0",
        "--port",
        "4173"
      ],
      "port": 4173
    }
  ]
}
